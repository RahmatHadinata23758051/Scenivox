# Bind locally by default. Set 0.0.0.0 only when intentionally exposing the API.
SCENIVOX_ADDR=127.0.0.1:3000
SCENIVOX_DATABASE_URL=sqlite://scenivox.db?mode=rwc

# Optional tracing filter, for example: debug,sqlx=warn
RUST_LOG=info

# Opt-in OpenAI-compatible endpoint preparation (disabled unless SCENIVOX_LLM_ENABLED=true)
# Supported kinds: remote_api | local_gateway_remote_upstream | local_endpoint
SCENIVOX_LLM_ENABLED=false
# SCENIVOX_LLM_PROVIDER_ID=ninerouter
# SCENIVOX_LLM_MODEL_ID=CODING
# SCENIVOX_LLM_ADAPTER_VERSION=1.0.0
# SCENIVOX_LLM_PROVIDER_KIND=local_gateway_remote_upstream
# SCENIVOX_LLM_BASE_URL=http://127.0.0.1:20128/v1
# SCENIVOX_LLM_ENDPOINT_ALLOWLIST=http://127.0.0.1:20128/v1
# SCENIVOX_LLM_GATEWAY_COMBO_ROUTING=true
# SCENIVOX_LLM_TOKENIZATION_ENCODING=o200k_base
# SCENIVOX_LLM_API_KEY_ENV=NINEROUTER_API_KEY
# SCENIVOX_LLM_REQUEST_TIMEOUT_MS=30000
# SCENIVOX_LLM_CONNECT_TIMEOUT_MS=5000
# SCENIVOX_LLM_MAX_REQUEST_BYTES=131072
# SCENIVOX_LLM_MAX_RESPONSE_BYTES=262144
# SCENIVOX_LLM_MAX_INPUT_TOKENS=16384
# SCENIVOX_LLM_MAX_OUTPUT_TOKENS=8192
# SCENIVOX_LLM_MAX_COST_MICROS=50000

