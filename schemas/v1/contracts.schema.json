{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scenivox:contracts:v1",
  "$comment": "Structural contract only. Cross-record, timing, hash and transition invariants are in technical-docs/DOMAIN_CONTRACT.md.",
  "oneOf": [
    {"$ref":"#/$defs/Project"}, {"$ref":"#/$defs/Revision"},
    {"$ref":"#/$defs/Approval"}, {"$ref":"#/$defs/RevisionReview"},
    {"$ref":"#/$defs/RenderJob"}, {"$ref":"#/$defs/Model"}, {"$ref":"#/$defs/Error"}
  ],
  "$defs": {
    "Id": {"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "Hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Name": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "Text": {"type":"string","minLength":1,"maxLength":10000},
    "Time": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "Selection": {"type":"object","additionalProperties":false,"required":["provider_id","model_id"],"properties":{"provider_id":{"$ref":"#/$defs/Name"},"model_id":{"$ref":"#/$defs/Name"}}},
    "Selections": {"type":"object","additionalProperties":false,"properties":{"storyboard_planning":{"$ref":"#/$defs/Selection"},"scene_code_generation":{"$ref":"#/$defs/Selection"}}},
    "Parameters": {"type":"object","additionalProperties":false,"required":["temperature"],"properties":{"temperature":{"type":"number","minimum":0,"maximum":2},"seed":{"type":"integer","minimum":0,"maximum":2147483647}}},
    "ModelSnapshot": {"type":"object","additionalProperties":false,"required":["provider_id","model_id","adapter_version","parameters","prompt_sha256"],"properties":{"provider_id":{"$ref":"#/$defs/Name"},"model_id":{"$ref":"#/$defs/Name"},"adapter_version":{"$ref":"#/$defs/Name"},"parameters":{"$ref":"#/$defs/Parameters"},"prompt_sha256":{"$ref":"#/$defs/Hash"}}},
    "ModelSnapshots": {"type":"object","additionalProperties":false,"required":["storyboard_planning","scene_code_generation"],"properties":{"storyboard_planning":{"$ref":"#/$defs/ModelSnapshot"},"scene_code_generation":{"$ref":"#/$defs/ModelSnapshot"}}},
    "PlanningPromptInput": {"type":"object","additionalProperties":false,"required":["schema_version","provider_id","model_id","adapter_version","idea","target"],"properties":{"schema_version":{"const":"scenivox.storyboard_planning.v1"},"provider_id":{"$ref":"#/$defs/Name"},"model_id":{"$ref":"#/$defs/Name"},"adapter_version":{"$ref":"#/$defs/Name"},"idea":{"$ref":"#/$defs/Text"},"target":{"$ref":"#/$defs/Target"}}},
    "ScenePromptInput": {"type":"object","additionalProperties":false,"required":["schema_version","provider_id","model_id","adapter_version","idea","target","storyboard"],"properties":{"schema_version":{"const":"scenivox.scene_generation.v1"},"provider_id":{"$ref":"#/$defs/Name"},"model_id":{"$ref":"#/$defs/Name"},"adapter_version":{"$ref":"#/$defs/Name"},"idea":{"$ref":"#/$defs/Text"},"target":{"$ref":"#/$defs/Target"},"storyboard":{"$ref":"#/$defs/StoryboardInput"}}},
    "DraftSceneInput": {"type":"object","additionalProperties":false,"required":["id","order","duration_ms","visual_direction","camera","action","narration","caption_hint","sfx_cues"],"properties":{"id":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},"order":{"type":"integer","minimum":0,"maximum":59},"duration_ms":{"type":"integer","minimum":1,"maximum":60000},"visual_direction":{"$ref":"#/$defs/Text"},"camera":{"$ref":"#/$defs/Text"},"action":{"$ref":"#/$defs/Text"},"narration":{"$ref":"#/$defs/Text"},"caption_hint":{"type":"string","maxLength":10000},"sfx_cues":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["asset_id","at_ms"],"properties":{"asset_id":{"$ref":"#/$defs/Id"},"at_ms":{"type":"integer","minimum":0,"maximum":60000}}}}}},
    "StoryboardInput": {"type":"object","additionalProperties":false,"required":["synopsis","hook","scenes"],"properties":{"synopsis":{"$ref":"#/$defs/Text"},"hook":{"$ref":"#/$defs/Text"},"scenes":{"type":"array","minItems":1,"maxItems":60,"items":{"$ref":"#/$defs/DraftSceneInput"}}}},
    "PlanningProvenance": {"type":"object","additionalProperties":false,"required":["source","prompt_input","prompt_sha256","scene_prompt_input","scene_prompt_sha256"],"properties":{"source":{"const":"deterministic_mock"},"prompt_input":{"$ref":"#/$defs/PlanningPromptInput"},"prompt_sha256":{"$ref":"#/$defs/Hash"},"scene_prompt_input":{"$ref":"#/$defs/ScenePromptInput"},"scene_prompt_sha256":{"$ref":"#/$defs/Hash"},"scene_id_mapping":{"type":"array","minItems":1,"maxItems":60,"items":{"type":"object","additionalProperties":false,"required":["order","scene_id"],"properties":{"order":{"type":"integer","minimum":0,"maximum":59},"scene_id":{"$ref":"#/$defs/Id"}}}}}},
    "Target": {"type":"object","additionalProperties":false,"required":["duration_ms","aspect_ratio","fps","language","style_id"],"properties":{"duration_ms":{"type":"integer","minimum":1,"maximum":60000},"aspect_ratio":{"const":"9:16"},"fps":{"const":30},"language":{"const":"id-ID"},"style_id":{"$ref":"#/$defs/Name"}}},
    "Project": {"type":"object","additionalProperties":false,"required":["schema_version","id","title","idea","target","model_selection","current_revision_id","approved_revision_id"],"properties":{"schema_version":{"const":"1"},"id":{"$ref":"#/$defs/Id"},"title":{"type":"string","minLength":1,"maxLength":200},"idea":{"$ref":"#/$defs/Text"},"target":{"$ref":"#/$defs/Target"},"model_selection":{"$ref":"#/$defs/Selections"},"current_revision_id":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},"approved_revision_id":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]}}},
    "Scene": {"type":"object","additionalProperties":false,"required":["id","order","duration_ms","visual_direction","camera","action","narration","caption_hint","sfx_cues"],"properties":{"id":{"$ref":"#/$defs/Id"},"order":{"type":"integer","minimum":0,"maximum":59},"duration_ms":{"type":"integer","minimum":1,"maximum":60000},"visual_direction":{"$ref":"#/$defs/Text"},"camera":{"$ref":"#/$defs/Text"},"action":{"$ref":"#/$defs/Text"},"narration":{"$ref":"#/$defs/Text"},"caption_hint":{"type":"string","maxLength":10000},"sfx_cues":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["asset_id","at_ms"],"properties":{"asset_id":{"$ref":"#/$defs/Id"},"at_ms":{"type":"integer","minimum":0,"maximum":60000}}}}}},
    "Storyboard": {"type":"object","additionalProperties":false,"required":["synopsis","hook","scenes"],"properties":{"synopsis":{"$ref":"#/$defs/Text"},"hook":{"$ref":"#/$defs/Text"},"scenes":{"type":"array","minItems":1,"maxItems":60,"items":{"$ref":"#/$defs/Scene"}}}},
    "RevisionContent": {"type":"object","additionalProperties":false,"required":["schema_version","idea","target","storyboard","models","asset_hashes","skill_id","skill_version"],"properties":{"schema_version":{"const":"1"},"idea":{"$ref":"#/$defs/Text"},"target":{"$ref":"#/$defs/Target"},"storyboard":{"$ref":"#/$defs/Storyboard"},"models":{"$ref":"#/$defs/ModelSnapshots"},"asset_hashes":{"type":"array","maxItems":1000,"uniqueItems":true,"items":{"$ref":"#/$defs/Hash"}},"skill_id":{"$ref":"#/$defs/Name"},"skill_version":{"$ref":"#/$defs/Name"},"planning_provenance":{"$ref":"#/$defs/PlanningProvenance"}}},
    "Revision": {"type":"object","additionalProperties":false,"required":["schema_version","id","project_id","parent_revision_id","version","created_at","content_sha256","content"],"properties":{"schema_version":{"const":"1"},"id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},"parent_revision_id":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},"version":{"type":"integer","minimum":1},"created_at":{"$ref":"#/$defs/Time"},"content_sha256":{"$ref":"#/$defs/Hash"},"content":{"$ref":"#/$defs/RevisionContent"}}},
    "ReviewCommand": {"type":"object","additionalProperties":false,"required":["schema_version","content_sha256"],"properties":{"schema_version":{"const":"1"},"content_sha256":{"$ref":"#/$defs/Hash"}}},
    "RevisionReview": {"type":"object","additionalProperties":false,"required":["schema_version","revision_id","review_state"],"properties":{"schema_version":{"const":"1"},"revision_id":{"$ref":"#/$defs/Id"},"review_state":{"enum":["draft","in_review","approved"]}}},
    "Approval": {"type":"object","additionalProperties":false,"required":["schema_version","id","project_id","revision_id","content_sha256","approved_at"],"properties":{"schema_version":{"const":"1"},"id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},"revision_id":{"$ref":"#/$defs/Id"},"content_sha256":{"$ref":"#/$defs/Hash"},"approved_at":{"$ref":"#/$defs/Time"}}},
    "RenderJob": {"type":"object","additionalProperties":false,"required":["schema_version","id","project_id","revision_id","approval_id","content_sha256","snapshot","status","retry_of_job_id","created_at","error_code","artifact_ids","cost_consent_id"],"properties":{"schema_version":{"const":"1"},"id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},"revision_id":{"$ref":"#/$defs/Id"},"approval_id":{"$ref":"#/$defs/Id"},"content_sha256":{"$ref":"#/$defs/Hash"},"snapshot":{"$ref":"#/$defs/RevisionContent"},"status":{"enum":["queued","preparing","voicing","animating","mixing","validating","succeeded","failed","cancelled","interrupted"]},"retry_of_job_id":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},"created_at":{"$ref":"#/$defs/Time"},"error_code":{"anyOf":[{"$ref":"#/$defs/Name"},{"type":"null"}]},"artifact_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Id"}},"cost_consent_id":{"anyOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]}}},
    "Model": {"type":"object","additionalProperties":false,"required":["schema_version","provider_id","model_id","adapter_version","task_roles","parameters","enabled","configured","availability","reason","remote"],"properties":{"schema_version":{"const":"1"},"provider_id":{"$ref":"#/$defs/Name"},"model_id":{"$ref":"#/$defs/Name"},"adapter_version":{"$ref":"#/$defs/Name"},"task_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["storyboard_planning","scene_code_generation"]}},"parameters":{"$ref":"#/$defs/Parameters"},"enabled":{"type":"boolean"},"configured":{"type":"boolean"},"availability":{"enum":["unknown","available","unavailable"]},"reason":{"type":"string","maxLength":500},"remote":{"type":"boolean"}}},
    "Error": {"type":"object","additionalProperties":false,"required":["schema_version","error"],"properties":{"schema_version":{"const":"1"},"error":{"type":"object","additionalProperties":false,"required":["code","message","details"],"properties":{"code":{"$ref":"#/$defs/Name"},"message":{"type":"string","minLength":1,"maxLength":500},"details":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["path","code"],"properties":{"path":{"type":"string","maxLength":500},"code":{"$ref":"#/$defs/Name"}}}}}}}}
  }
}
